# Vite
.vite/

# Environment — real secrets. Only the .example templates are committed.
.env
.env.local
.env.*.local
deploy/.env
deploy/.env.deploy
deploy/data/

# ── Backend runtime state — never commit (user data / secrets) ────────────
backend/data/             # SQLite: user accounts, per-user projects, support threads
backend/objects/          # version-history content-addressable blobs
backend/history.json      # version-history commit log
backend/bubble_graph.json # single-user live graph
backend/backups/
backend/uploads/          # user-uploaded IFC models

