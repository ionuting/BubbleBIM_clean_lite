{
  "name": "bubble-graph",
  "version": "1.14.1",
  "private": true,
  "description": "Standalone BubbleGraph visual building editor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:3100 && electron .\"",
    "dev:lite": "vite --config vite.lite.config.ts",
    "build": "tsc --noEmitOnError false && vite build",
    "build:deploy": "vite build",
    "build:electron": "tsc --noEmitOnError false && vite build && electron-builder",
    "build:lite": "vite build --config vite.lite.config.ts && node scripts/postbuild-lite.js",
    "dev:minimal": "vite --config vite.minimal.config.ts",
    "build:minimal": "vite build --config vite.minimal.config.ts && node scripts/postbuild-minimal.js",
    "preview:minimal": "vite preview --config vite.minimal.config.ts --outDir dist-minimal",
    "dev:clean": "vite --config apps/clean-lite/vite.config.ts",
    "build:clean": "vite build --config apps/clean-lite/vite.config.ts && node scripts/postbuild-clean-lite.js",
    "preview:clean": "vite preview --config apps/clean-lite/vite.config.ts --outDir dist-clean-lite",
    "deploy": "bash deploy/deploy.sh",
    "preview": "vite preview",
    "preview:lite": "vite preview --config vite.lite.config.ts --outDir dist-lite",
    "electron": "electron .",
    "test": "vitest run",
    "test:takeoff": "vitest run src/lib/quantityTakeoff/takeoffEngine.test.ts",
    "import:deviz-ods": "python3 scripts/import-deviz-ods.py"
  },
  "dependencies": {
    "@awatif/components": "^3.2.0",
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/loaders": "^9.0.0",
    "@ifc-lite/create": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@thatopen/components": "^3.4.6",
    "@thatopen/components-front": "^3.4.3",
    "@thatopen/fragments": "^3.4.5",
    "@turf/turf": "^7.3.5",
    "@xyflow/react": "^12.7.0",
    "cesium": "^1.141.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "manifold-3d": "^3.5.1",
    "mathjs": "^15.2.0",
    "opengeometry": "^2.0.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.10",
    "web-ifc": "0.0.77",
    "zustand": "^4.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder",
      "electron-winstaller"
    ],
    "ignoredBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.bubblegraph.editor",
    "productName": "BubbleGraph",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^3.2.6",
    "wait-on": "^9.0.4"
  }
}
